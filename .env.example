# Security
SECRET_KEY=change-this-to-a-very-strong-random-secret-key-in-production
FLASK_DEBUG=0

# Database Configuration (SQLite default, or postgresql://user:pass@host:5432/dbname)
DATABASE_URL=sqlite:///daycare.db

# Server Settings
PORT=5000
SOCKETIO_ASYNC_MODE=threading

# Daycare Center Details
DAYCARE_NAME=Little Learners Virtual Daycare
DAYCARE_PHONE=+1 (555) 234-5678
DAYCARE_EMAIL=info@littlelearnersdaycare.com
DAYCARE_ADDRESS=123 Sunshine Lane, Suite 100, Cityville, CA 90210

# Initial Director Account Bootstrap (for python init_db.py)
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@daycare.com
ADMIN_PASSWORD=AdminSecure2026!
